---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Serena Dang | Tailoring & Alterations">
  <section id="about">
    <p class="section-kicker">The person behind the needle</p>
    <h2>About Me</h2>
    <div class="about-content">
      <div class="about-text">
        <p class="about-lede">Hi, I'm Serena, the owner of Serena Dang Tailoring & Alterations.</p>
        <p>
          Sewing has been a passion of mine for years, and I love helping people
          feel confident in the clothes they wear. With more than five years of
          professional experience in garment construction and alterations, I
          work on everything from everyday wardrobe pieces and suits to formal
          wear, bridal gowns, heirloom garments, and home textiles.
        </p>
        <p>
          For the past three years, I've worked alongside skilled tailors at
          Nordstrom, refining my craftsmanship and learning to deliver precise,
          efficient work across a wide range of garments.
        </p>
        <p>
          One of my proudest projects was designing and creating my own wedding
          gown and veil from scratch. From sketching and pattern-making to
          selecting fabrics and engineering the gown's structure, the project
          challenged me to develop advanced couture techniques. I bring that
          same thoughtful attention to every fitting, whether I'm tailoring a
          favorite suit, preparing a gown, or hemming curtains for your home.
        </p>
        <div class="about-details" aria-label="About Serena">
          <div>
            <strong>5+</strong>
            <span>Years of experience</span>
          </div>
          <div>
            <strong>Oceanside, CA</strong>
            <span>Serving the local community</span>
          </div>
          <div>
            <strong>Crafted with care</strong>
            <span>Thoughtful, precise work</span>
          </div>
        </div>
      </div>
      <div class="about-image">
        <img src="/serena.png" alt="Serena in her wedding gown" />
        <p class="about-caption">Serena wearing the wedding gown she designed and created from scratch.</p>
      </div>
    </div>
  </section>

  <section id="services">
    <p class="section-kicker">Thoughtful work, clearly priced</p>
    <h2>Services &amp; Pricing</h2>

    <div class="service-group">
      <h3>Pants &amp; Jeans</h3>
      <ul class="service-list">
        <li><span>Standard Pant Hem</span><span>$10</span></li>
        <li><span>Original Jean Hem</span><span>$15</span></li>
        <li><span>Cuff Hem</span><span>$15</span></li>
        <li><span>Waist In/Out</span><span>$20</span></li>
        <li><span>Seat Adjustment</span><span>$20</span></li>
        <li><span>Leg Taper</span><span>$20</span></li>
        <li><span>Replace Zipper</span><span>$20</span></li>
        <li><span>Replace Button</span><span>$5</span></li>
        <li><span>Patch Hole</span><span>$10-20</span></li>
        <li><span>Shorten Rise</span><span>$30</span></li>
      </ul>
    </div>

    <div class="service-group">
      <h3>Shirts &amp; Blouses</h3>
      <ul class="service-list">
        <li><span>T-Shirt Hem</span><span>$10</span></li>
        <li><span>Sleeve Shortening</span><span>$15</span></li>
        <li><span>Take In Sides</span><span>$15</span></li>
        <li><span>Collar Repair</span><span>$15</span></li>
        <li><span>Replace Buttons</span><span>$2 each</span></li>
        <li><span>Add Darts</span><span>$15</span></li>
      </ul>
    </div>

    <div class="service-group">
      <h3>Dresses &amp; Skirts</h3>
      <ul class="service-list">
        <li><span>Dress Hem</span><span>Starting at $20</span></li>
        <li><span>Take In / Let Out</span><span>Starting at $25</span></li>
        <li><span>Strap Adjustment</span><span>$10</span></li>
        <li><span>Sleeve Alterations</span><span>Starting at $20</span></li>
        <li><span>Add Bra Cups</span><span>$15</span></li>
        <li><span>Replace Zipper</span><span>$25</span></li>
        <li><span>Bust Adjustment</span><span>Starting at $25</span></li>
        <li><span>Skirt Hem</span><span>$15</span></li>
        <li><span>Waist Adjustment</span><span>$20</span></li>
      </ul>
    </div>

    <div class="service-group">
      <h3>Bridal &amp; Formal Wear</h3>
      <ul class="service-list">
        <li><span>Wedding Gown Hem</span><span>Starting at $80</span></li>
        <li><span>Bustle</span><span>Starting at $50</span></li>
        <li><span>Take In / Let Out</span><span>Starting at $40</span></li>
        <li><span>Strap Adjustment</span><span>$15-20</span></li>
        <li><span>Sleeve Additions</span><span>Quote</span></li>
        <li><span>Lace &amp; Applique Work</span><span>Quote</span></li>
        <li><span>Bridesmaid Dresses</span><span>Starting at $25</span></li>
        <li><span>Prom Dresses</span><span>Starting at $25</span></li>
        <li><span>Veil Alterations</span><span>Quote</span></li>
      </ul>
    </div>

    <div class="service-group">
      <h3>Home Textiles</h3>
      <ul class="service-list">
        <li><span>Curtain Hem</span><span>$15 per panel</span></li>
        <li><span>Drapery Hem</span><span>$20 per panel</span></li>
        <li><span>Tablecloth Hem</span><span>Starting at $15</span></li>
        <li><span>Cushion Zipper</span><span>$20</span></li>
        <li><span>Pillow Repair</span><span>$10</span></li>
      </ul>
    </div>

    <div class="service-group">
      <h3>Repairs</h3>
      <ul class="service-list">
        <li><span>Replace Zipper</span><span>$20-30</span></li>
        <li><span>Replace Buttons</span><span>$2 each</span></li>
        <li><span>Seam Repair</span><span>$10-15</span></li>
        <li><span>Patch Hole</span><span>$10-20</span></li>
        <li><span>Elastic Replacement</span><span>$15-20</span></li>
      </ul>
    </div>

    <div class="service-group appointment-note">
      <h3>By Appointment Only</h3>
      <p class="center">
        To ensure personalized service and the perfect fit, all appointments are
        scheduled in advance.
      </p>
    </div>

    <div class="service-group pricing-note">
      <div class="center">
        <h5>Please Note</h5>
        <p>
          Prices may vary depending on garment construction, lining, fabric
          type, embellishments, or alteration complexity.
        </p>
        <p>
          Bridal gowns, formal wear, leather, and custom work are individually
          quoted after your fitting.
        </p>
      </div>
    </div>
  </section>

  <section id="contact">
    <p class="section-kicker">Let's make it fit beautifully</p>
    <h2>Contact</h2>
    <div class="pricing-note contact-note">
      <div class="center">
        <h5>Please Note</h5>
        <p>
          We currently serve clients locally around Oceanside, CA. We do not
          accept out-of-state or mail-in alteration inquiries.
        </p>
      </div>
    </div>

    <form id="contact-form" class="contact-form">
      <label for="firstName">
        First name
        <input type="text" name="firstName" id="firstName" required />
      </label>

      <label for="lastName">
        Last name
        <input type="text" name="lastName" id="lastName" required />
      </label>

      <label for="email">
        Email
        <input type="email" name="email" id="email" required />
      </label>

      <label for="phoneNumber">
        Phone number
        <input type="tel" name="phoneNumber" id="phoneNumber" required />
      </label>

      <label for="message">
        Message
        <textarea name="message" id="message" rows="5" required></textarea>
      </label>

      <button type="submit">Submit</button>
      <div id="form-status" class="form-status" aria-live="polite"></div>
    </form>
  </section>
</BaseLayout>
